---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout
  lang="el"
  title="Η σελίδα δεν βρέθηκε | Pantelis Stanimeros"
  description="Η σελίδα που ψάχνεις δεν υπάρχει."
  canonical="https://stanimeros.com/el"
  noindex
>
  <main class="container mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <p class="text-xl text-muted-foreground mb-8">Η σελίδα δεν βρέθηκε.</p>
    <a
      href="/el"
      class="inline-flex items-center justify-center rounded-md h-12 px-6 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
    >
      Πίσω στην αρχική
    </a>
  </main>
</BaseLayout>
