---
import '@/index.css'
import AppDownloadPage from '@/components/AppDownloadPage.astro'
import { getAppDownloadPages } from '@/lib/app-download'

export function getStaticPaths() {
  return getAppDownloadPages().map((app) => ({
    params: { appSlug: app.slug },
    props: { app },
  }))
}

const { app } = Astro.props
---

<AppDownloadPage app={app} lang="el" />
