---
import '@/index.css'
import ParticlesBackground from '@/components/ParticlesBackground'
import { getAppDownloadPages } from '@/lib/app-download'
import en from '@/i18n/locales/en/main.json'

export function getStaticPaths() {
  return getAppDownloadPages().map((app) => ({
    params: { appSlug: app.slug },
    props: { app },
  }))
}

const { app } = Astro.props
const portfolioItem = en.portfolio.items[app.key as keyof typeof en.portfolio.items]
const title = portfolioItem?.title ?? app.key
const description = app.storeComingSoon
  ? `Coming soon on the App Store and Google Play. ${portfolioItem?.description ?? ''}`.trim()
  : portfolioItem?.description ?? `Download ${title} on the App Store and Google Play.`
const canonical = `https://stanimeros.com/${app.slug}`
const ogImage = app.logo
  ? `https://stanimeros.com${app.logo}`
  : 'https://stanimeros.com/images/logo-glass-black.png'

const isAppleBeta = app.storeLinks?.apple?.includes('testflight.apple.com') ?? false
const isAndroidBeta = app.storeLinks?.android?.includes('/apps/testing/') ?? false

const appleIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor" class="size-12 shrink-0" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>'
const androidIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor" class="size-12 shrink-0" aria-hidden="true"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/></svg>'

const mobileAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: title,
  description,
  operatingSystem: 'iOS, Android',
  applicationCategory: 'UtilitiesApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(app.storeLinks?.apple && { downloadUrl: app.storeLinks.apple }),
  ...(app.logo && { image: ogImage }),
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{app.storeComingSoon ? `${title} — Coming soon` : `${title} — Download the app`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo-glass-black.png" />
    <link rel="apple-touch-icon" href={app.logo ?? '/images/logo-glass-black.png'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap&subset=greek,latin"
    />
    <meta property="og:title" content={app.storeComingSoon ? `${title} — Coming soon` : `${title} — Download the app`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(mobileAppJsonLd)} />
  </head>
  <body>
    <div class="min-h-svh bg-background text-foreground relative">
      <ParticlesBackground client:idle />
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10" />
      <div class="relative z-10 min-h-svh flex flex-col items-center justify-center px-4 py-10">
        <div class="w-full max-w-sm flex flex-col items-center text-center">
          {app.logo ? (
            <div
              class:list={[
                'size-24 rounded-3xl flex items-center justify-center border border-border/60 shadow-lg mb-5 overflow-hidden shrink-0',
                app.logoBg ?? 'bg-card',
              ]}
            >
              <img
                src={app.logo}
                alt={title}
                class="size-full object-cover"
                width="96"
                height="96"
              />
            </div>
          ) : (
            <div
              class={`size-24 rounded-3xl flex items-center justify-center text-3xl font-bold border border-border/60 shadow-lg mb-5 ${app.bgColor} ${app.textColor}`}
            >
              {title.slice(0, 2).toUpperCase()}
            </div>
          )}

          <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
          <p class="text-muted-foreground text-sm mt-2 mb-8 leading-relaxed max-w-xs">{description}</p>

          <div class="w-full flex flex-col gap-3">
            {app.storeComingSoon ? (
              <>
                <div
                  class="flex items-center gap-4 w-full rounded-2xl border border-border/60 bg-[#1a1a1a]/80 px-5 py-4 text-white opacity-75 cursor-default"
                  aria-disabled="true"
                >
                  <Fragment set:html={appleIcon} />
                  <div class="text-left min-w-0">
                    <div class="text-xs text-white/70 leading-none">Coming soon on the</div>
                    <div class="text-lg font-semibold leading-tight mt-1">App Store</div>
                  </div>
                </div>
                <div
                  class="flex items-center gap-4 w-full rounded-2xl border border-border/60 bg-[#01875f]/80 px-5 py-4 text-white opacity-75 cursor-default"
                  aria-disabled="true"
                >
                  <Fragment set:html={androidIcon} />
                  <div class="text-left min-w-0">
                    <div class="text-xs text-white/80 leading-none">Coming soon on</div>
                    <div class="text-lg font-semibold leading-tight mt-1">Google Play</div>
                  </div>
                </div>
              </>
            ) : (
              <>
                {app.storeLinks?.apple && (
                  <div class="relative w-full">
                    <a
                      href={app.storeLinks.apple}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track-store="apple"
                      data-apple-link
                      class="flex items-center gap-4 w-full rounded-2xl border border-border/60 bg-[#1a1a1a] px-5 py-4 text-white hover:bg-[#2a2a2a] transition-colors shadow-md"
                    >
                      <Fragment set:html={appleIcon} />
                      <div class="text-left min-w-0">
                        <div class="text-xs text-white/70 leading-none">
                          {isAppleBeta ? 'Join the beta on' : 'Download on the'}
                        </div>
                        <div class="text-lg font-semibold leading-tight mt-1">
                          {isAppleBeta ? 'TestFlight' : 'App Store'}
                        </div>
                      </div>
                    </a>
                    <div
                      data-apple-hint
                      class="hidden absolute z-20 top-full left-0 right-0 mt-2 rounded-xl border border-border/60 bg-card p-3 text-xs leading-snug shadow-md text-foreground text-left"
                    >
                      Instagram blocks this link. Tap ⋯ (top right) and choose "Open in Browser" to open the App Store.
                    </div>
                  </div>
                )}

                {app.storeLinks?.android && (
                  <a
                    href={app.storeLinks.android}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-store="android"
                    data-android-link
                    data-android-href={app.storeLinks.android}
                    data-android-web-href={app.storeLinks.androidWeb ?? ''}
                    class="flex items-center gap-4 w-full rounded-2xl border border-border/60 bg-[#01875f] px-5 py-4 text-white hover:bg-[#01a06f] transition-colors shadow-md"
                  >
                    <Fragment set:html={androidIcon} />
                    <div class="text-left min-w-0">
                      <div class="text-xs text-white/80 leading-none">Get it on</div>
                      <div class="text-lg font-semibold leading-tight mt-1">
                        {isAndroidBeta ? 'Google Play (Beta)' : 'Google Play'}
                      </div>
                    </div>
                  </a>
                )}
              </>
            )}
          </div>

          <a
            href="https://stanimeros.com"
            class="mt-10 text-xs text-muted-foreground hover:text-foreground transition-colors"
          >
            stanimeros.com
          </a>
        </div>
      </div>
    </div>

    <script define:vars={{ appSlug: app.slug, appTitle: title }}>
      import { trackEvent } from '@/lib/events'

      trackEvent('pageView', { page: 'app-download', app: appSlug })

      function isIosInstagramInAppBrowser() {
        const ua = navigator.userAgent
        return /Instagram/i.test(ua) && /iPhone|iPad|iPod/i.test(ua)
      }

      document.querySelectorAll('[data-apple-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          trackEvent('ctaClick', {
            source: 'app-download',
            section: 'apple',
            label: appTitle,
            app: appSlug,
          })

          if (!isIosInstagramInAppBrowser()) return
          e.preventDefault()
          const hint = link.parentElement?.querySelector('[data-apple-hint]')
          if (!hint) return
          hint.classList.remove('hidden')
          window.setTimeout(() => hint.classList.add('hidden'), 6000)
        })
      })

      document.querySelectorAll('[data-android-link]').forEach((link) => {
        link.addEventListener('click', (e) => {
          trackEvent('ctaClick', {
            source: 'app-download',
            section: 'android',
            label: appTitle,
            app: appSlug,
          })

          const isAndroid = /android/i.test(navigator.userAgent)
          const androidHref = link.dataset.androidHref
          const androidWebHref = link.dataset.androidWebHref
          const href = isAndroid ? androidHref : androidWebHref || androidHref
          if (!href) return
          if (!isAndroid && androidWebHref) {
            e.preventDefault()
            window.open(href, '_blank', 'noopener,noreferrer')
          }
        })
      })
    </script>
  </body>
</html>
